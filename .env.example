# =============================================
# GY Roadside Solutions LLC — Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# Variables prefixed PUBLIC_ are exposed to the browser.
# Do NOT put private secrets in PUBLIC_ variables.

# Site URL (used for canonical URLs, sitemap, Open Graph)
PUBLIC_SITE_URL=https://gyroadsidesolutions.com

# Contact info
PUBLIC_PHONE=+12143027757
PUBLIC_EMAIL=service@gyroadsidesolutions.com

# Contact form provider — Web3Forms
# The Access Key is injected at build time and is NOT committed to git.
# On Netlify set it in: Site configuration → Environment variables.
# Get a key at https://web3forms.com then restrict it in the Web3Forms dashboard
# (Captcha + allowed domains) because it is exposed to the browser at runtime.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# External form endpoint (unused with Web3Forms; kept for reference)
PUBLIC_FORM_ENDPOINT=

# Google Maps embed URL (confirm with client)
PUBLIC_GOOGLE_MAPS_URL=

# Google Business Profile URL (confirm with client)
PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=

# Analytics — leave blank to disable
PUBLIC_GA_ID=
PUBLIC_GTM_ID=

# Google Search Console verification meta tag (confirm with client)
PUBLIC_GSC_VERIFICATION=

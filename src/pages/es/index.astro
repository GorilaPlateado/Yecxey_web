---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import ServiceGrid from "@/components/ServiceGrid.astro";
import StatsBand from "@/components/StatsBand.astro";
import TrustSection from "@/components/TrustSection.astro";
import CoverageStrip from "@/components/CoverageStrip.astro";
import AboutTeaser from "@/components/AboutTeaser.astro";
import EmergencyBand from "@/components/EmergencyBand.astro";
import FAQ from "@/components/FAQ.astro";
import GoogleReviewsCTA from "@/components/GoogleReviewsCTA.astro";
import { t } from "@/i18n/index";
import business from "@/data/business";
import site from "@/config/site";
import { homeFAQ } from "@/data/homeFAQ";

const lang = "es";
const tr = t(lang);
const canonicalUrl = `${site.url}/es/`;
const alternateUrl = `${site.url}/en/`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "AutomotiveBusiness"],
  name: business.name,
  url: site.url,
  telephone: business.phone,
  email: business.email,
  openingHours: "Mo-Su 00:00-23:59",
  areaServed: { "@type": "Country", name: "United States" },
  sameAs: [business.googleBusinessProfileUrl, business.social.facebook, business.social.instagram, business.social.tiktok].filter(Boolean),
};
---

<BaseLayout
  title={`${business.name} — Asistencia en Carretera para Camiones Comerciales 24/7`}
  description="GY Roadside Solutions LLC ofrece asistencia en carretera 24/7 para camiones comerciales en todo EE.UU. Cambio de llanta, arranque, entrega de combustible, frenos, mantenimiento reefer y más."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  structuredData={pageSchema}
>
  <Hero lang={lang} />

  <!-- Proceso en 3 pasos -->
  <HowItWorks lang={lang} />

  <!-- Servicios destacados -->
  <ServiceGrid lang={lang} featuredOnly limit={6} />

  <!-- Banda de credibilidad -->
  <StatsBand lang={lang} />

  <!-- Señales de confianza + CTA -->
  <TrustSection lang={lang} />

  <!-- Cobertura + mapa -->
  <CoverageStrip lang={lang} />

  <!-- Humanizar la marca -->
  <AboutTeaser lang={lang} />

  <!-- CTA de emergencia -->
  <EmergencyBand lang={lang} />

  <!-- FAQ para SEO -->
  <FAQ lang={lang} items={homeFAQ} />

  <!-- Embudo de reseñas de Google -->
  <GoogleReviewsCTA lang={lang} />

  <!-- CTA final -->
  <section class="section bg-light" aria-labelledby="cta2-heading">
    <div class="container text-center max-w-2xl">
      <h2 id="cta2-heading" class="text-primary mb-4">
        ¿Listo para Regresar a la Carretera?
      </h2>
      <p class="text-muted text-lg mb-8">
        No espere en la orilla de la autopista. Llame a GY Roadside Solutions LLC para asistencia rápida y profesional para camiones comerciales — las 24 horas del día.
      </p>
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4 justify-center">
        <a href={`tel:${business.phone}`} class="btn-primary self-center text-center text-base sm:text-lg sm:whitespace-nowrap py-4 px-6 sm:px-10">
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Llamar Ahora — {business.phoneDisplay}
        </a>
        <a href="/es/contacto/" class="btn-outline-dark text-lg py-4 px-10">
          Solicitar Asistencia en Carretera
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

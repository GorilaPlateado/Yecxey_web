---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { confirmedAreas } from "@/data/serviceAreas";
import business from "@/data/business";
import site from "@/config/site";

const lang = "es";
const canonicalUrl = `${site.url}/es/area-de-servicio/`;
const alternateUrl = `${site.url}/en/service-area/`;
---

<BaseLayout
  title={`Área de Servicio — ${business.name}`}
  description="GY Roadside Solutions LLC ofrece asistencia en carretera para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas: Dallas, Fort Worth, Arlington, Irving, Plano y más. Llame al (214) 302-7757."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "Área de Servicio" }]} />

  <section class="section" aria-labelledby="area-heading">
    <div class="container">
      <div class="section-heading">
        <h1 id="area-heading" class="text-primary">Área de Servicio</h1>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          GY Roadside Solutions LLC ofrece asistencia en carretera para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas.
        </p>
        <span class="heading-accent" aria-hidden="true"></span>
      </div>

      <div class="max-w-3xl mx-auto mt-10">
        <!-- Coverage CTA -->
        <div class="bg-primary/5 border border-primary/20 rounded-2xl p-6 mb-10 text-center">
          <p class="text-primary font-bold text-lg mb-2">¿No sabe si cubrimos su área?</p>
          <p class="text-muted mb-4">Llámenos y le confirmamos si podemos llegar a donde usted está.</p>
          <a href={`tel:${business.phone}`} class="btn-primary">
            Llamar (214) 302-7757
          </a>
        </div>

        {confirmedAreas.length > 0 ? (
          <div class="bg-white border border-border rounded-2xl p-6 text-center">
            <p class="font-bold text-primary text-lg mb-1">Zonas de servicio</p>
            <p class="text-muted text-sm mb-4">Brindamos asistencia móvil en las siguientes ciudades de Dallas-Fort Worth, Texas.</p>
            <ul class="flex flex-wrap justify-center gap-2" role="list">
              {confirmedAreas.map((area) => (
                <li class="inline-flex items-center gap-2 bg-primary/5 border border-primary/20 rounded-full px-4 py-2">
                  <svg aria-hidden="true" class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span class="font-semibold text-dark">{area.city}</span>
                  <span class="text-muted text-xs">{area.stateCode}</span>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 text-sm text-yellow-800">
            <p class="font-bold mb-2">📋 Zonas de servicio pendientes de confirmación del cliente.</p>
            <p>Una vez confirmadas, las ciudades específicas aparecerán aquí. Llámenos para verificar cobertura en su ubicación.</p>
          </div>
        )}

        <!-- Google Maps embed -->
        {business.googleMapsUrl ? (
          <div class="mt-10 rounded-2xl overflow-hidden border border-border aspect-video">
            <iframe
              src={business.googleMapsUrl}
              width="100%"
              height="100%"
              style="border:0"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Mapa del área de servicio de GY Roadside Solutions LLC"
            ></iframe>
          </div>
        ) : (
          <div class="mt-10 bg-light rounded-2xl border border-border flex items-center justify-center aspect-video">
            <p class="text-muted text-center p-8">[MAPA GOOGLE MAPS — configure PUBLIC_GOOGLE_MAPS_URL en .env]</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

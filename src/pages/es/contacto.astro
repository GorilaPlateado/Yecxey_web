---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "es";
const canonicalUrl = `${site.url}/es/contacto/`;
const alternateUrl = `${site.url}/en/contact-us/`;
---

<BaseLayout
  title={`Contáctenos — ${business.name}`}
  description="Contacte a GY Roadside Solutions LLC para asistencia en carretera para camiones comerciales. Llame al (214) 302-7757 o complete nuestro formulario. Disponible 24/7."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "Contacto" }]} />

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-heading">
        <h1 id="contact-heading" class="text-primary">Contáctenos</h1>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          Complete el formulario o llámenos directamente para asistencia inmediata en carretera — disponible las 24 horas.
        </p>
        <span class="heading-accent" aria-hidden="true"></span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-12">
        <aside class="lg:col-span-1 space-y-6">
          <div class="card p-6 border-l-4 border-secondary">
            <h2 class="font-bold text-dark text-lg mb-3">Llámenos Directamente</h2>
            <p class="text-muted text-sm mb-4">Para asistencia inmediata, llamar es la opción más rápida.</p>
            <a href={`tel:${business.phone}`} class="btn-primary w-full justify-center text-lg">
              <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {business.phoneDisplay}
            </a>
          </div>

          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Envíenos un Correo</h2>
            <a href={`mailto:${business.email}`} class="text-primary hover:text-primary-light transition-colors break-all text-sm font-medium">
              {business.email}
            </a>
          </div>

          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Horario de Atención</h2>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-success rounded-full animate-pulse" aria-hidden="true"></span>
              <span class="text-success font-bold">Disponible 24/7</span>
            </div>
            <p class="text-muted text-sm mt-2">Lunes – Domingo, las 24 horas</p>
          </div>

          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Síguenos</h2>
            <div class="flex gap-3">
              {business.social.facebook && (
                <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
                  class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
                  <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
              )}
              {business.social.instagram && (
                <a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                  class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
                  <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                  </svg>
                </a>
              )}
              {business.social.tiktok && (
                <a href={business.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"
                  class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors">
                  <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </aside>

        <div class="lg:col-span-2">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

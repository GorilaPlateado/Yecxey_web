---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import SocialIcons from "@/components/SocialIcons.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "es";
const canonicalUrl = `${site.url}/es/contacto/`;
const alternateUrl = `${site.url}/en/contact-us/`;
---

<BaseLayout
  title={`Contáctenos — ${business.name}`}
  description="Contacte a GY Roadside Solutions LLC para asistencia en carretera para camiones comerciales. Llame al (214) 302-7757 o complete nuestro formulario. Disponible 24/7."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "Contacto" }]} />

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-heading">
        <h1 id="contact-heading" class="text-primary">Contáctenos</h1>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          Complete el formulario o llámenos directamente para asistencia inmediata en carretera — disponible las 24 horas.
        </p>
        <span class="heading-accent" aria-hidden="true"></span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-12">
        <aside class="lg:col-span-1 space-y-6">
          <div class="card p-6 border-l-4 border-secondary">
            <h2 class="font-bold text-dark text-lg mb-3">Llámenos Directamente</h2>
            <p class="text-muted text-sm mb-4">Para asistencia inmediata, llamar es la opción más rápida.</p>
            <a href={`tel:${business.phone}`} class="btn-primary w-full justify-center text-lg">
              <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {business.phoneDisplay}
            </a>
          </div>

          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Envíenos un Correo</h2>
            <a href={`mailto:${business.email}`} class="text-primary hover:text-primary-light transition-colors break-all text-sm font-medium">
              {business.email}
            </a>
          </div>

          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Horario de Atención</h2>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-success rounded-full animate-pulse" aria-hidden="true"></span>
              <span class="text-success font-bold">Disponible 24/7</span>
            </div>
            <p class="text-muted text-sm mt-2">Lunes – Domingo, las 24 horas</p>
          </div>

          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Síguenos</h2>
            <SocialIcons variant="card" />
          </div>
        </aside>

        <div class="lg:col-span-2">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AboutGallery from "@/components/AboutGallery.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "es";
const canonicalUrl = `${site.url}/es/nosotros/`;
const alternateUrl = `${site.url}/en/about-us/`;

const sections = [
  {
    n: "01",
    title: "Historia de la empresa",
    paras: [
      "GY Roadside Solutions LLC nació de un sueño personal de emprender y del deseo de construir un negocio propio. La idea surgió como un proyecto compartido entre el fundador y su esposa, con la ilusión de crear algo propio y desarrollar una empresa para el futuro.",
      "Hoy, GY Roadside Solutions LLC se enfoca en brindar asistencia confiable en carretera para vehículos ligeros, camiones comerciales y remolques estándar en el área metropolitana de Dallas–Fort Worth y sus alrededores. Nuestro objetivo es ofrecer un servicio práctico y confiable a los conductores siempre que necesiten asistencia en carretera.",
    ],
  },
  {
    n: "02",
    title: "Experiencia y trayectoria",
    paras: [
      "GY Roadside Solutions LLC cuenta con un año de experiencia brindando asistencia en carretera. Nos enfocamos en ofrecer un servicio práctico y confiable para ayudar a los conductores de vehículos ligeros y camiones comerciales a regresar a la carretera de la manera más segura y eficiente posible.",
    ],
  },
  {
    n: "03",
    title: "Tipos de clientes",
    paras: [
      "GY Roadside Solutions LLC ofrece servicios a conductores particulares, transportistas independientes, propietarios-operadores y profesionales del transporte comercial en el área metropolitana de Dallas–Fort Worth y sus alrededores.",
      "Nuestro objetivo es establecer relaciones sólidas y duraderas con conductores particulares y transportistas independientes, al mismo tiempo que buscamos oportunidades para colaborar con empresas de transporte y operadores de flotas que necesiten asistencia confiable en carretera para sus vehículos.",
      "Estamos comprometidos con el crecimiento de nuestra empresa mediante un servicio profesional, confiable y práctico.",
    ],
  },
  {
    n: "04",
    title: "Qué nos diferencia",
    paras: [
      "En GY Roadside Solutions LLC creemos que la asistencia en carretera es mucho más que reparar un vehículo. Se trata de ayudar a las personas que quedan varadas en la carretera, muchas veces lejos de casa y enfrentándose a dificultades inesperadas.",
      "Creemos que cada conductor merece recibir un trato amable, humilde, paciente y respetuoso. Nos esforzamos por ofrecer un servicio profesional y de calidad, comunicarnos con honestidad y dar lo mejor de nosotros en cada llamada.",
      "Somos una empresa en crecimiento, pero nuestro compromiso es sencillo: estar al lado de cada cliente. Porque en la carretera nadie debería sentirse solo cuando más necesita ayuda.",
    ],
  },
];
---

<BaseLayout
  title={`Nosotros — ${business.name}`}
  description="Conozca la historia de GY Roadside Solutions LLC — asistencia confiable en carretera para vehículos ligeros, camiones comerciales y remolques en el área de Dallas–Fort Worth. Disponibles 24/7."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "Nosotros" }]} />

  <section class="section" aria-labelledby="about-heading">
    <div class="container max-w-3xl">
      <!-- Intro -->
      <div class="section-heading text-left mb-10">
        <span class="section-label">Quiénes somos</span>
        <h1 id="about-heading" class="text-primary">Sobre GY Roadside Solutions LLC</h1>
        <span class="heading-accent !mx-0" aria-hidden="true"></span>
      </div>

      <p class="text-lg text-dark leading-relaxed mb-10">
        Una empresa de asistencia en carretera fundada por una familia, construida sobre una idea simple: brindar a los conductores una ayuda confiable y honesta — dondequiera que el camino los lleve.
      </p>

      <!-- Premium photo gallery -->
      <div class="mb-16">
        <AboutGallery lang={lang} />
      </div>

      <!-- Content sections -->
      {sections.map((s) => (
        <article class="mb-12">
          <div class="mb-5 flex items-center gap-4">
            <span class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-full bg-primary text-base font-bold text-accent" aria-hidden="true">{s.n}</span>
            <h2 class="text-primary text-2xl">{s.title}</h2>
          </div>
          <div class="space-y-4 border-l-2 border-accent/50 pl-6">
            {s.paras.map((p) => (
              <p class="text-muted leading-relaxed">{p}</p>
            ))}
          </div>
        </article>
      ))}

      <!-- CTA -->
      <div class="mt-14 rounded-2xl bg-primary px-6 py-10 text-center">
        <h2 class="text-xl font-bold text-white mb-2">¿Necesita asistencia en carretera confiable?</h2>
        <p class="text-white/80 mb-6">Estamos al lado de cada cliente — disponibles 24/7 en Dallas–Fort Worth y sus alrededores.</p>
        <a href={`tel:${business.phone}`} class="btn-primary text-lg py-4 px-10">
          Llamar — {business.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

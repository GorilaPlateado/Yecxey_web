---
import business from "@/data/business";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 — Page Not Found | GY Roadside Solutions LLC</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background: #F8FAFC; color: #0F172A; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; }
      .num { font-size: 8rem; font-weight: 800; color: #1B3A8C; line-height: 1; }
      h1 { font-size: 1.75rem; font-weight: 700; margin: 1rem 0 0.5rem; }
      p { color: #64748B; margin-bottom: 2rem; max-width: 28rem; }
      .links { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
      a.btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 2rem; border-radius: 0.75rem; font-weight: 700; text-decoration: none; transition: opacity 0.2s; }
      a.btn:hover { opacity: 0.85; }
      .btn-primary { background: #C8102E; color: white; }
      .btn-outline { background: white; border: 2px solid #1B3A8C; color: #1B3A8C; }
    </style>
  </head>
  <body>
    <div class="num" aria-hidden="true">404</div>
    <h1>Page Not Found</h1>
    <p>The page you're looking for doesn't exist or has been moved. Let us help you get back on track.</p>
    <div class="links">
      <a href="/en/" class="btn btn-outline">← Go to Homepage</a>
      <a href={`tel:${business.phone}`} class="btn btn-primary">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        {business.phoneDisplay}
      </a>
    </div>
    <p style="margin-top:3rem;font-size:0.8rem;color:#94A3B8;">También disponible en <a href="/es/" style="color:#1B3A8C;">Español</a></p>
  </body>
</html>

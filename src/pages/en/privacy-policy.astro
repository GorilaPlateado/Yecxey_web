---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/privacy-policy/`;
const alternateUrl = `${site.url}/es/politica-de-privacidad/`;

// Fixed effective date — do NOT derive from the build date. Update this string
// only when the policy text actually changes (and re-publish).
const LAST_UPDATED = "October 25, 2026";

// Mailing address used for legal / privacy notices (CAN-SPAM §316 requirement).
const mailingAddress = `${business.address}, ${business.city}, ${business.state} ${business.zipCode}, ${business.country}`;
---

<BaseLayout
  title={`Privacy Policy — ${business.name}`}
  description="Privacy Policy for the GY Roadside Solutions LLC website: what data we collect, how we use it, your California and other state privacy rights, data retention, and how to contact us."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  noIndex={false}
>
  <Breadcrumbs lang={lang} items={[{ label: "Privacy Policy" }]} />

  <section class="section">
    <div class="container max-w-3xl">
      <h1 class="text-primary mb-2">Privacy Policy</h1>
      <p class="text-muted text-sm mb-10">Last Updated: {LAST_UPDATED}</p>

      <div class="prose space-y-6 text-dark">
        <section>
          <h2 class="text-primary">1. Introduction</h2>
          <p>
            This Privacy Policy explains how {business.name} ("we", "us", or "our")
            collects, uses, discloses, and safeguards your information when you visit
            our website ({site.url}) (the "Site") or request our roadside-assistance
            services. By using the Site, you agree to the practices described here. If
            you do not agree, please do not use the Site.
          </p>
          <p>
            We are the data controller for the information described in this policy.
            Our contact details are listed in Section 13.
          </p>
        </section>

        <section>
          <h2 class="text-primary">2. Information We Collect</h2>
          <p>We collect only the information needed to respond to your service request and to operate the Site:</p>
          <ul class="list-disc pl-6 space-y-1">
            <li><strong>Information you provide us.</strong> When you use the contact form or call us, you may give us your name, phone number, email address, current location, service requested, truck/vehicle details, and a description of the problem.</li>
            <li><strong>Communications.</strong> Records of the calls, texts, or emails we exchange with you to coordinate assistance.</li>
            <li><strong>Automatically collected information.</strong> Basic technical data such as device/browser type and the page you came from, only to the extent any analytics tool is enabled. Analytics tools are currently disabled on this Site (see Section 6).</li>
          </ul>
          <p class="mt-3 text-sm text-muted">We do not collect sensitive personal information (such as Social Security numbers, financial account numbers, health, or biometric data) through the Site.</p>
        </section>

        <section>
          <h2 class="text-primary">3. How We Use Your Information</h2>
          <p>We use your information to:</p>
          <ul class="list-disc pl-6 space-y-1">
            <li>Respond to and coordinate your roadside-assistance request.</li>
            <li>Contact you by phone, text message, or email about the service you requested.</li>
            <li>Maintain records of service requests for our own business and legal purposes.</li>
            <li>Improve our services and website, and to comply with legal obligations, prevent fraud, and enforce our rights.</li>
          </ul>
          <p class="mt-3">We do <strong>not</strong> sell your personal information, and we do <strong>not</strong> share it with third parties for their marketing.</p>
        </section>

        <section>
          <h2 class="text-primary">4. Phone &amp; Text Message Consent (TCPA)</h2>
          <p>
            If you provide a phone number, you consent to be contacted at that number
            by phone call and/or SMS/text message for the purpose of coordinating the
            service you request. Message and data rates may apply. Consent is not a
            condition of purchase. You may withdraw this consent at any time by
            replying "STOP" to a text or by contacting us using the details in
            Section 13. We do not use your number for automated marketing without
            your separate consent.
          </p>
          <p>
            When you submit a request through our contact form we ask for this consent
            separately from the privacy acknowledgment, and we record the date and the
            policy version you accepted, so you can prove what you agreed to.
          </p>
        </section>

        <section>
          <h2 class="text-primary">5. How We Share Information</h2>
          <p>
            We share information only with trusted service providers who help us
            operate the Site and respond to requests (for example, the form-delivery
            service described in Section 8, and hosting/email providers). These
            providers may process your information only to perform services for us and
            are expected to keep it confidential. We may also disclose information if
            required by law, to respond to a valid legal process, or to protect our
            rights, safety, or property.
          </p>
        </section>

        <section>
          <h2 class="text-primary">6. Cookies &amp; Analytics</h2>
          <p>
            This Site does not use advertising or tracking cookies by default.
            If analytics tools (such as Google Analytics or Google Tag Manager) are
            later enabled, they may set cookies to help us understand site usage.
            Analytics are only active when a valid tracking ID is configured, and IP
            anonymization is used where supported. If analytics are enabled, this
            Site's cookie notice will be updated accordingly. Most browsers let you
            refuse cookies through their settings.
          </p>
        </section>

        <section>
          <h2 class="text-primary">7. Data Retention</h2>
          <p>
            We keep contact-form submissions and related communications only as long
            as necessary to provide the service, resolve disputes, meet legal, tax and
            accounting requirements, and otherwise operate our business — generally no
            longer than what is needed to service a request and maintain business
            records. You may ask us to delete your information (see Section 9).
          </p>
        </section>

        <section>
          <h2 class="text-primary">8. Third-Party Services &amp; Links</h2>
          <p>
            Our contact form is processed by Web3Forms. Please review
            <a href="https://web3forms.com/privacy" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Web3Forms' Privacy Policy</a>
            to understand how it handles form data. The Site may also link to Google
            Maps, Google Business Profile, Facebook, Instagram, and TikTok. Those
            services have their own privacy policies, we are not responsible for their
            practices, and this policy applies only to information we collect.
          </p>
        </section>

        <section>
          <h2 class="text-primary">9. Your California &amp; Other State Privacy Rights</h2>
          <p>
            If you are a resident of California, Colorado, Connecticut, Texas, Virginia,
            or another U.S. state with a comprehensive consumer-privacy law, you may
            have the following rights regarding personal information we hold about you.
            We do not "sell" or "share" personal information as those terms are defined
            by the California Consumer Privacy Act (CCPA/CPRA) or other state laws.
          </p>
          <ul class="list-disc pl-6 space-y-1">
            <li><strong>Right to know</strong> the categories, sources, purposes, and recipients of personal information we collect.</li>
            <li><strong>Right to access</strong> a copy of the personal information we hold about you.</li>
            <li><strong>Right to deletion</strong> of personal information we collected from you (subject to legal exceptions).</li>
            <li><strong>Right to correction</strong> of inaccurate personal information.</li>
            <li><strong>Right to opt out</strong> of the sale or sharing of personal information (we do not sell or share it) and of automated profiling for decisions about you.</li>
            <li><strong>Right to be free from discrimination</strong> for exercising these rights.</li>
          </ul>
          <p class="mt-3">
            To exercise a right, use the contact details in Section 13 or email us with
            the subject line "Privacy Request". We may need to verify your identity
            before fulfilling a request. You may use an authorized agent; we may ask for
            proof of that authorization. We will respond within the timeframe required by
            applicable law (generally 45 days, extendable once by 45 days).
          </p>
          <div class="rounded-lg bg-light border border-border p-4 text-sm">
            <strong>Categories of personal information collected in the last 12 months:</strong>
            identifiers (name, phone, email), geolocation (current location you provide),
            commercial information (service requested, vehicle details), and internet/usage
            activity (only if analytics is enabled). We do not collect sensitive personal
            information. This information is collected directly from you and used for the
            business purposes in Sections 3–4.
          </div>
        </section>

        <section>
          <h2 class="text-primary">10. Children's Privacy</h2>
          <p>
            The Site is not directed to children under 16, and we do not knowingly
            collect personal information from children. If you believe a child has
            provided us information, contact us so we can delete it.
          </p>
        </section>

        <section>
          <h2 class="text-primary">11. Data Security</h2>
          <p>
            We take reasonable administrative, technical, and organizational measures
            to protect your information. However, no method of transmission over the
            Internet or electronic storage is completely secure, and we cannot guarantee
            absolute security.
          </p>
        </section>

        <section>
          <h2 class="text-primary">12. Changes &amp; Governing Law</h2>
          <p>
            We may update this Privacy Policy from time to time. Material changes will
            be posted on this page with an updated "Last Updated" date. This policy is
            governed by the laws of the State of Texas, U.S.A., without regard to
            conflict-of-law rules.
          </p>
        </section>

        <section>
          <h2 class="text-primary">13. Contact Us</h2>
          <p>
            If you have questions about this Privacy Policy or wish to exercise a privacy
            right, contact us at:<br />
            <strong>{business.name}</strong><br />
            {mailingAddress}<br />
            <a href={`mailto:${business.email}`} class="text-primary hover:underline">{business.email}</a><br />
            <a href={`tel:${business.phone}`} class="text-primary hover:underline">{business.phoneDisplay}</a>
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

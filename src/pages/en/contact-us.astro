---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import SocialIcons from "@/components/SocialIcons.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/contact-us/`;
const alternateUrl = `${site.url}/es/contacto/`;
---

<BaseLayout
  title={`Contact Us — ${business.name}`}
  description="Contact GY Roadside Solutions LLC for commercial truck roadside assistance. Call (214) 302-7757 or fill out our form."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "Contact Us" }]} />

  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="section-heading">
        <h1 id="contact-heading" class="text-primary">Contact Us</h1>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          Fill out the form below or call us directly for immediate roadside assistance.
        </p>
        <span class="heading-accent" aria-hidden="true"></span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-12">
        <!-- Contact info sidebar -->
        <aside class="lg:col-span-1 space-y-6">
          <!-- Call card -->
          <div class="card p-6 border-l-4 border-secondary">
            <h2 class="font-bold text-dark text-lg mb-3">Call Us Directly</h2>
            <p class="text-muted text-sm mb-4">For immediate assistance, calling is the fastest option.</p>
            <a
              href={`tel:${business.phone}`}
              class="btn-primary w-full justify-center text-lg"
              aria-label={`Call ${business.phoneDisplay}`}
            >
              <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              {business.phoneDisplay}
            </a>
          </div>

          <!-- Email card -->
          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Email Us</h2>
            <a
              href={`mailto:${business.email}`}
              class="text-primary hover:text-primary-light transition-colors break-all text-sm font-medium"
            >
              {business.email}
            </a>
          </div>

          <!-- Hours card -->
          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Hours of Operation</h2>
            <p class="text-muted text-sm">Service availability depends on the schedule and the conditions of each request.</p>
          </div>

          <!-- Social -->
          <div class="card p-6">
            <h2 class="font-bold text-dark text-lg mb-3">Follow Us</h2>
            <SocialIcons variant="card" />
          </div>
        </aside>

        <!-- Form -->
        <div class="lg:col-span-2">
          <ContactForm lang={lang} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

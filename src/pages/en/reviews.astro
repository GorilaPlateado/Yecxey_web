---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import business from "@/data/business";
import site from "@/config/site";
import {
  GOOGLE_BUSINESS_PROFILE_URL,
  GOOGLE_REVIEW_LINK,
  isProfileConfigured,
  isReviewLinkConfigured,
} from "@/config/reviews";

const lang = "en";
const canonicalUrl = `${site.url}/en/reviews/`;
const alternateUrl = `${site.url}/es/resenas/`;

// Links open in a new tab only once a real URL is configured (see src/config/reviews.ts).
const profileLive = isProfileConfigured();
const reviewLive = isReviewLinkConfigured();
---

<BaseLayout
  title={`Customer Reviews — ${business.name}`}
  description="Read verified customer reviews for GY Roadside Solutions LLC on our Google Business Profile. Professional commercial truck roadside assistance. Call (214) 302-7757."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "Reviews" }]} />

  <section class="section" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="section-heading">
        <h1 id="reviews-heading" class="text-primary">Customer Reviews</h1>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          Verified feedback from real customers.
        </p>
        <span class="heading-accent" aria-hidden="true"></span>
      </div>

      <div class="max-w-2xl mx-auto mt-12">
        <div class="card p-8 text-center md:p-12">
          <!-- Google badge -->
          <div class="mb-6 flex justify-center">
            <svg viewBox="0 0 48 48" class="h-14 w-14" role="img" aria-label="Google" focusable="false">
              <path fill="#FFC107" d="M43.611,20.083H40V20H24v8h11.304c-1.649,4.657-6.081,8-11.304,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
              <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,19.06,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.688,8.337,6.306,14.691z"/>
              <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.314,35.093,26.794,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
              <path fill="#1976D2" d="M43.611,20.083H40V20H24v8h11.304c-0.792,2.237-2.23,4.166-4.087,5.571l6.19,5.238C36.964,39.205,44,34,44,24C44,22.163,43.862,21.35,43.611,20.083z"/>
            </svg>
          </div>

          <h2 class="text-primary font-bold text-2xl mb-4">Verified by Google</h2>

          <p class="text-dark/80 text-lg leading-relaxed mb-8">
            All customer reviews are verified through Google Business Profile.
            We believe in transparency and only display authentic feedback from
            real customers.
          </p>

          <!-- Temporary state shown until the client connects a real Google Business Profile -->
          {!profileLive && (
            <p class="rounded-lg bg-light border border-border px-4 py-3 text-sm text-muted mb-8">
              Google reviews will appear here once the business profile is verified
              and customer reviews become available.
            </p>
          )}

          <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <!-- TODO: link comes from src/config/reviews.ts → GOOGLE_BUSINESS_PROFILE_URL -->
            <a
              href={GOOGLE_BUSINESS_PROFILE_URL}
              target={profileLive ? "_blank" : undefined}
              rel={profileLive ? "noopener noreferrer" : undefined}
              class="btn-primary"
            >
              Read Our Google Reviews
            </a>

            <!-- TODO: link comes from src/config/reviews.ts → GOOGLE_REVIEW_LINK -->
            <a
              href={GOOGLE_REVIEW_LINK}
              target={reviewLive ? "_blank" : undefined}
              rel={reviewLive ? "noopener noreferrer" : undefined}
              class="btn-outline-dark"
            >
              Leave a Review
            </a>
          </div>
        </div>

        <!-- Conversion CTA (preserved) -->
        <div class="mt-12 text-center">
          <p class="text-muted text-lg mb-4">Need roadside assistance right now?</p>
          <a href={`tel:${business.phone}`} class="btn-outline-dark">
            Call {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ReviewCard from "@/components/ReviewCard.astro";
import { confirmedReviews, getAverageRating } from "@/data/reviews";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/reviews/`;
const alternateUrl = `${site.url}/es/resenas/`;
const avgRating = getAverageRating();

// Only add AggregateRating schema when real reviews exist
const pageSchema = avgRating !== null ? {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: avgRating,
    reviewCount: confirmedReviews.length,
  },
} : undefined;
---

<BaseLayout
  title={`Customer Reviews — ${business.name}`}
  description="Read customer reviews for GY Roadside Solutions LLC. Professional commercial truck roadside assistance. Call (214) 302-7757."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  structuredData={pageSchema}
>
  <Breadcrumbs lang={lang} items={[{ label: "Reviews" }]} />

  <section class="section" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="section-heading">
        <h1 id="reviews-heading" class="text-primary">Customer Reviews</h1>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          Real reviews from drivers we've helped on the road.
        </p>
        <span class="heading-accent" aria-hidden="true"></span>
      </div>

      {confirmedReviews.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
          {confirmedReviews.map((review) => (
            <ReviewCard review={review} lang={lang} />
          ))}
        </div>
      ) : (
        <div class="max-w-xl mx-auto mt-12 text-center">
          <div class="card p-10">
            <div class="text-5xl mb-4" aria-hidden="true">⭐</div>
            <h2 class="text-dark font-bold text-xl mb-3">Customer reviews will appear here soon.</h2>
            <p class="text-muted mb-6">We're proud of the service we provide. Check back soon for reviews from our customers.</p>
            {business.googleBusinessProfileUrl && (
              <a
                href={business.googleBusinessProfileUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                Leave a Review on Google
              </a>
            )}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-14 text-center">
        <p class="text-muted text-lg mb-6">Had a great experience? We'd love to hear from you.</p>
        {business.googleBusinessProfileUrl ? (
          <a href={business.googleBusinessProfileUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Leave a Google Review
          </a>
        ) : (
          <p class="text-muted text-sm">[Google Business Profile URL — confirm with client]</p>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

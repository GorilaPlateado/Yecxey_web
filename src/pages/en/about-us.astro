---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AboutGallery from "@/components/AboutGallery.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/about-us/`;
const alternateUrl = `${site.url}/es/nosotros/`;

const sections = [
  {
    n: "01",
    title: "Company History and Founding Story",
    paras: [
      "GY Roadside Solutions LLC was born from the desire to build a family business. This project was conceived by the founder and his wife, driven by the enthusiasm to start, create, and develop an initiative with its own identity, grounded in hard work, persistence, and dedication.",
    ],
  },
  {
    n: "02",
    title: "Experience and Background",
    paras: [
      "Our company has one year of experience providing roadside assistance to all kinds of vehicles. We focus on delivering professional, practical, and quality service to help drivers get back on their way as safely and efficiently as possible.",
    ],
  },
  {
    n: "03",
    title: "Types of Clients Served",
    paras: [
      "Our services are aimed at individual drivers, independent truck drivers, owner-operators, and commercial transportation professionals in Dallas-Fort Worth.",
      "We seek to build solid, lasting relationships with independent truck drivers, and to collaborate with transportation companies and fleet operators who need timely assistance for their vehicles.",
    ],
  },
  {
    n: "04",
    title: "What Makes Us Different",
    paras: [
      "At GY Roadside Solutions LLC, we believe mobile assistance is much more than repairing a vehicle. It is about standing by those left with a broken-down vehicle on the side of the road, often far from home and unsure how to continue their journey.",
      "We are a growing company committed to providing each customer with close, personalized attention. Because on the road, when a problem arises, having someone willing to help can make all the difference.",
    ],
  },
];
---

<BaseLayout
  title={`About Us — ${business.name}`}
  description="Learn the story of GY Roadside Solutions LLC — reliable roadside assistance for light-duty vehicles, commercial trucks, and trailers in the Dallas–Fort Worth area. Available 24/7."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
>
  <Breadcrumbs lang={lang} items={[{ label: "About Us" }]} />

  <section class="section" aria-labelledby="about-heading">
    <div class="container max-w-3xl">
      <!-- Intro -->
      <div class="section-heading text-left mb-10">
        <span class="section-label">Who we are</span>
        <h1 id="about-heading" class="text-primary">About GY Roadside Solutions LLC</h1>
        <span class="heading-accent !mx-0" aria-hidden="true"></span>
      </div>

      <p class="text-lg text-dark leading-relaxed mb-10">
        A family-founded roadside assistance company built on a simple idea: giving drivers dependable, honest help — wherever the road takes them.
      </p>

      <!-- Premium photo gallery -->
      <div class="mb-16">
        <AboutGallery lang={lang} />
      </div>

      <!-- Content sections -->
      {sections.map((s) => (
        <article class="mb-12">
          <div class="mb-5 flex items-center gap-4">
            <span class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-full bg-primary text-base font-bold text-accent" aria-hidden="true">{s.n}</span>
            <h2 class="text-primary text-2xl">{s.title}</h2>
          </div>
          <div class="space-y-4 border-l-2 border-accent/50 pl-6">
            {s.paras.map((p) => (
              <p class="text-muted leading-relaxed">{p}</p>
            ))}
          </div>
        </article>
      ))}

      <!-- CTA -->
      <div class="mt-14 rounded-2xl bg-primary px-6 py-10 text-center">
        <h2 class="text-xl font-bold text-white mb-2">Need reliable roadside assistance?</h2>
        <p class="text-white/80 mb-6">We stand by every customer — available 24/7 in Dallas–Fort Worth and beyond.</p>
        <a href={`tel:${business.phone}`} class="btn-primary text-lg py-4 px-10">
          Call Us — {business.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

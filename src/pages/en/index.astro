---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import ServiceGrid from "@/components/ServiceGrid.astro";
import StatsBand from "@/components/StatsBand.astro";
import TrustSection from "@/components/TrustSection.astro";
import CoverageStrip from "@/components/CoverageStrip.astro";
import AboutTeaser from "@/components/AboutTeaser.astro";
import FAQ from "@/components/FAQ.astro";
import GoogleReviewsCTA from "@/components/GoogleReviewsCTA.astro";
import { t } from "@/i18n/index";
import business from "@/data/business";
import site from "@/config/site";
import { homeFAQ } from "@/data/homeFAQ";

const lang = "en";
const tr = t(lang);
const canonicalUrl = `${site.url}/en/`;
const alternateUrl = `${site.url}/es/`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "AutomotiveBusiness"],
  name: business.name,
  url: site.url,
  telephone: business.phone,
  email: business.email,
  areaServed: ["Dallas", "Irving", "Addison", "Carrollton", "Farmers Branch"].map((city) => ({ "@type": "City", name: `${city}, TX` })),
  sameAs: [business.googleBusinessProfileUrl, business.social.facebook, business.social.instagram, business.social.tiktok].filter(Boolean),
};
---

<BaseLayout
  title={`${business.name} — Roadside Assistance for Commercial Trucks and Other Vehicles`}
  description="GY Roadside Solutions LLC provides mobile assistance for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area: tires, brakes, fuel, reefer units, oil changes and emergency jump starts."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  structuredData={pageSchema}
>
  <Hero lang={lang} />

  <!-- 3-step process -->
  <HowItWorks lang={lang} />

  <!-- Services highlight -->
  <ServiceGrid lang={lang} featuredOnly limit={6} />

  <!-- Qualitative credibility band -->
  <StatsBand lang={lang} />

  <!-- Trust signals + CTA strip -->
  <TrustSection lang={lang} />

  <!-- Coverage + embedded map -->
  <CoverageStrip lang={lang} />

  <!-- Humanize the brand -->
  <AboutTeaser lang={lang} />

  <!-- SEO FAQ -->
  <FAQ lang={lang} items={homeFAQ} />

  <!-- Google reviews funnel -->
  <GoogleReviewsCTA lang={lang} />

  <!-- Final CTA section -->
  <section class="section bg-light" aria-labelledby="cta2-heading">
    <div class="container text-center max-w-2xl">
      <h2 id="cta2-heading" class="text-primary mb-4">
        Need Assistance for Your Vehicle?
      </h2>
      <p class="text-muted text-lg mb-8">
        Contact GY Roadside Solutions LLC to request mobile service for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area.
      </p>
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4 justify-center">
        <a href={`tel:${business.phone}`} class="btn-primary self-center text-center text-base sm:text-lg sm:whitespace-nowrap py-4 px-6 sm:px-10">
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call Now — {business.phoneDisplay}
        </a>
        <a href="/en/contact-us/" class="btn-outline-dark text-lg py-4 px-10">
          Request Assistance
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

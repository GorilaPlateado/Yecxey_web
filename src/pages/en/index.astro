---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ServiceGrid from "@/components/ServiceGrid.astro";
import TrustSection from "@/components/TrustSection.astro";
import { t } from "@/i18n/index";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const tr = t(lang);
const canonicalUrl = `${site.url}/en/`;
const alternateUrl = `${site.url}/es/`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "AutomotiveBusiness"],
  name: business.name,
  url: site.url,
  telephone: business.phone,
  email: business.email,
  openingHours: "Mo-Su 00:00-23:59",
  areaServed: { "@type": "Country", name: "United States" },
  sameAs: [business.social.facebook, business.social.instagram, business.social.tiktok].filter(Boolean),
};
---

<BaseLayout
  title={`${business.name} — Commercial Truck Roadside Assistance 24/7`}
  description="GY Roadside Solutions LLC provides 24/7 commercial truck roadside assistance across the US. Tire change, jump start, fuel delivery, brake service, reefer maintenance & more."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  structuredData={pageSchema}
>
  <Hero lang={lang} />

  <!-- Services highlight -->
  <ServiceGrid lang={lang} featuredOnly limit={6} />

  <!-- Trust signals + CTA strip -->
  <TrustSection lang={lang} />

  <!-- Second CTA section -->
  <section class="section bg-light" aria-labelledby="cta2-heading">
    <div class="container text-center max-w-2xl">
      <h2 id="cta2-heading" class="text-primary mb-4">
        Ready to Get Back on the Road?
      </h2>
      <p class="text-muted text-lg mb-8">
        Don't wait on the side of the highway. Call GY Roadside Solutions LLC for fast, professional commercial truck assistance — 24 hours a day.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`tel:${business.phone}`} class="btn-primary text-lg py-4 px-10">
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call Now — {business.phoneDisplay}
        </a>
        <a href="/en/contact-us/" class="btn-outline text-lg py-4 px-10">
          Request Roadside Assistance
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

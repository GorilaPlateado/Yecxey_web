---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import business from "@/data/business";
import site from "@/config/site";

const lang = "en";
const canonicalUrl = `${site.url}/en/accessibility/`;
const alternateUrl = `${site.url}/es/accesibilidad/`;

// Fixed dates — REVIEWED is the date of our most recent internal check.
const LAST_UPDATED = "October 25, 2026";
const REVIEWED = "October 25, 2026";

const mailingAddress = `${business.address}, ${business.city}, ${business.state} ${business.zipCode}, ${business.country}`;
const privacyPath = "/en/privacy-policy/";
const termsPath   = "/en/terms-of-use/";
---

<BaseLayout
  title={`Accessibility Statement — ${business.name}`}
  description="Accessibility statement for the GY Roadside Solutions LLC website: our commitment to WCAG 2.1 AA conformance, the features implemented, known limitations, and how to report an accessibility barrier."
  lang={lang}
  canonicalUrl={canonicalUrl}
  alternateUrl={alternateUrl}
  noIndex={false}
>
  <Breadcrumbs lang={lang} items={[{ label: "Accessibility" }]} />

  <section class="section">
    <div class="container max-w-3xl">
      <h1 class="text-primary mb-2">Accessibility Statement</h1>
      <p class="text-muted text-sm mb-10">Last Updated: {LAST_UPDATED}</p>

      <div class="prose space-y-6 text-dark">
        <section>
          <h2 class="text-primary">1. Our Commitment</h2>
          <p>
            {business.name} wants every driver, dispatcher and fleet operator who visits
            {site.url} to be able to use it — including people who use a keyboard only,
            a screen reader, screen magnification, voice control, or who have low vision,
            color blindness, or cognitive or motor disabilities. Access to roadside
            assistance can be a safety issue, so we treat accessibility as part of the
            service, not as an extra feature.
          </p>
          <p>
            We aim to meet the <strong>Web Content Accessibility Guidelines (WCAG) 2.1
            Level AA</strong>, the recognized standard used in U.S. accessibility law and
            litigation, and we also follow Section 508 guidance for federal-style
            accessibility criteria.
          </p>
        </section>

        <section>
          <h2 class="text-primary">2. Conformance Status</h2>
          <p>
            This Site is <strong>partially conformant</strong> with WCAG 2.1 Level AA. It
            was designed and built to the criteria listed in Section 3, and we last
            reviewed it internally on {REVIEWED}. It has not yet been audited by an
            independent third party using assistive technology, and parts of the Site that
            are controlled by third parties (notably the embedded Google Maps views) are
            outside our direct control.
          </p>
          <p class="text-sm text-muted">
            We would rather tell you accurately where we stand than over-claim. If you hit
            a barrier, please tell us — see Section 5 — and we will fix it or give you the
            information another way.
          </p>
        </section>

        <section>
          <h2 class="text-primary">3. Accessibility Features Already Implemented</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Keyboard navigation.</strong> A "Skip to main content" link is the first focusable element on every page, and all interactive controls are reachable and operable with the keyboard alone.</li>
            <li><strong>Visible focus.</strong> Focused elements show a clear outline (2&nbsp;px, brand yellow, offset by 3&nbsp;px) so you can always tell where you are — contrast ratios well above the WCAG 3:1 non-text minimum.</li>
            <li><strong>Text contrast.</strong> Body text uses a dark navy on a light background with a contrast ratio of roughly 12.5:1, which exceeds the WCAG AAA threshold of 7:1.</li>
            <li><strong>Touch targets.</strong> Buttons and links meet or exceed a 44&nbsp;&times;&nbsp;44&nbsp;px target area (48&nbsp;px on primary buttons), which supports motor and tremor disabilities.</li>
            <li><strong>Screen-reader support.</strong> Semantic landmarks (header, nav, main, footer), heading order, ARIA labels on icon-only controls, <code>aria-current</code> on the active navigation item, and live regions that announce form submission status.</li>
            <li><strong>Images.</strong> Every informative image has descriptive alternative text; decorative images are hidden from assistive technology.</li>
            <li><strong>Forms.</strong> Every field has a visible label, required fields are marked programmatically, validation errors are announced and tied to the field with <code>aria-invalid</code> and <code>aria-describedby</code>, and error messages appear in the language you chose.</li>
            <li><strong>Motion.</strong> Animations and smooth scrolling are reduced automatically when your system requests <em>prefers-reduced-motion</em>.</li>
            <li><strong>Zoom and reflow.</strong> Pages scale with browser zoom and reflow to a single column on small screens, so content is readable at 200% zoom without horizontal scrolling.</li>
            <li><strong>Language.</strong> Each page declares its language to assistive technology, and the Site is fully available in both English and Spanish.</li>
            <li><strong>Maps.</strong> Every embedded map frame carries a descriptive <code>title</code>, and the same service-area information is also provided as plain text, so no one needs the map to understand where we work.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-primary">4. Known Limitations and Ongoing Work</h2>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Third-party map embeds.</strong> The interactive Google Maps window is rendered by Google and follows Google's own accessibility; we cannot change its internals. The textual city list alongside it is fully accessible.</li>
            <li><strong>Third-party form delivery.</strong> Contact-form submissions are processed by Web3Forms. The form itself is built and labeled by us; the confirmation page shown after a successful send is handled by that provider.</li>
            <li><strong>Independent audit pending.</strong> We have not yet completed a formal audit with screen readers (NVDA/JAWS/VoiceOver) or a professional accessibility assessment. That is our next step, and we will update this statement when it is done.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-primary">5. Feedback and How to Reach Us</h2>
          <p>
            If any part of this Site is difficult for you, or if you would prefer to
            receive our service information by phone, large print or email, please contact
            us and we will respond promptly — we will answer your service request by an
            accessible alternative while we fix the problem.
          </p>
          <p class="mt-3">
            <strong>{business.name}</strong><br />
            {mailingAddress}<br />
            <a href={`mailto:${business.email}`} class="text-primary hover:underline">{business.email}</a><br />
            <a href={`tel:${business.phone}`} class="text-primary hover:underline">{business.phoneDisplay}</a>
          </p>
          <p class="mt-3 text-sm text-muted">
            We aim to acknowledge accessibility feedback within 2 business days and to
            resolve it, or provide the information another way, within 10 business days.
          </p>
        </section>

        <section>
          <h2 class="text-primary">6. Technical Standards and Compatibility</h2>
          <ul class="list-disc pl-6 space-y-1">
            <li>Web Content Accessibility Guidelines (WCAG) 2.1 Level AA</li>
            <li>Section 508 of the U.S. Rehabilitation Act (guidance)</li>
            <li>HTML5, ARIA and CSS as rendered by current versions of Chrome, Edge, Firefox and Safari, on desktop and mobile.</li>
          </ul>
          <p class="mt-3">
            The Site relies on these technologies, so users who disable them may lose
            layout or interactive features. Core information remains readable as plain
            text in any browser.
          </p>
        </section>

        <section>
          <h2 class="text-primary">7. Enforcement</h2>
          <p>
            In the United States, website accessibility complaints are generally handled
            under Title III of the Americans with Disabilities Act. If you are unable to
            resolve a barrier with us directly, you may contact the U.S. Department of
            Justice. Our first preference, however, is to hear from you and fix it.
          </p>
        </section>

        <section>
          <h2 class="text-primary">8. Related Documents</h2>
          <p>
            <a href={termsPath} class="text-primary hover:underline font-medium">Terms of Use</a>
            &nbsp;·&nbsp;
            <a href={privacyPath} class="text-primary hover:underline font-medium">Privacy Policy</a>
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

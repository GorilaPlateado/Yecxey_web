---
import business from "@/data/business";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
const contactPath = lang === "es" ? `/${lang}/contacto/` : `/${lang}/contact-us/`;
---

<div
  class="fixed bottom-0 left-0 right-0 z-50 lg:hidden grid grid-cols-2 shadow-[0_-2px_16px_rgba(0,0,0,0.2)]"
  role="region"
  aria-label={lang === "es" ? "Acciones rápidas" : "Quick actions"}
>
  <!-- Call Now — yellow -->
  <a
    href={`tel:${business.phone}`}
    class="flex items-center justify-center gap-2 py-4 bg-accent text-dark font-bold text-sm hover:bg-accent-light active:scale-95 transition-all min-h-[56px]"
    aria-label={`${lang === "es" ? "Llamar" : "Call"} ${business.phoneDisplay}`}
  >
    <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
    </svg>
    {lang === "es" ? "Llamar Ahora" : "Call Now"}
  </a>

  <!-- Contact Us — dark navy -->
  <a
    href={contactPath}
    class="flex items-center justify-center gap-2 py-4 bg-primary text-white font-bold text-sm hover:bg-primary-light active:scale-95 transition-all min-h-[56px] border-l border-white/10"
    aria-label={lang === "es" ? "Contáctenos" : "Contact Us"}
  >
    <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
    </svg>
    {lang === "es" ? "Contáctenos" : "Contact Us"}
  </a>
</div>

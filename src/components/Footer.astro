---
import Navigation from "@/components/Navigation.astro";
import business from "@/data/business";
import { activeServices } from "@/data/services";
import { t } from "@/i18n/index";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
const currentYear = new Date().getFullYear();
const servicesPath = lang === "es" ? `/es/servicios/` : `/en/services/`;
const privacyPath  = lang === "es" ? `/es/politica-de-privacidad/` : `/en/privacy-policy/`;
---

<footer class="bg-primary text-white" role="contentinfo">

  <!-- Main footer grid -->
  <div class="container pt-14 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div>
        <a href={`/${lang}/`} aria-label={`${business.name} — Home`} class="inline-block mb-5">
          <img
            src="/images/logo.webp"
            alt={`${business.name} logo`}
            width="160" height="54"
            class="h-11 w-auto object-contain"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
          />
          <div class="hidden">
            <span class="text-secondary font-black text-xl">GY</span>
            <span class="text-white font-bold text-sm ml-1">ROADSIDE</span>
          </div>
        </a>
        <p class="text-white/75 text-sm leading-relaxed mb-5">
          {lang === "es"
            ? "Asistencia en carretera profesional para camiones comerciales en todo Estados Unidos."
            : "Professional roadside assistance for commercial trucks across the United States."}
        </p>
        <!-- 24/7 pill -->
        <div class="inline-flex items-center gap-2 bg-accent/15 border border-accent/30 text-accent text-xs font-bold px-3 py-1.5 rounded-full">
          <span class="w-2 h-2 bg-accent rounded-full animate-pulse" aria-hidden="true"></span>
          24/7 {lang === "es" ? "Disponible" : "Available"}
        </div>

        <!-- Social links -->
        <div class="flex items-center gap-3 mt-5">
          {business.social.facebook && (
            <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
               class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent hover:text-dark text-white/60 flex items-center justify-center transition-colors">
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {business.social.instagram && (
            <a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
               class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent hover:text-dark text-white/60 flex items-center justify-center transition-colors">
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          )}
          {business.social.tiktok && (
            <a href={business.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"
               class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent hover:text-dark text-white/60 flex items-center justify-center transition-colors">
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-5 opacity-70">
          {lang === "es" ? "Navegación" : "Quick Links"}
        </h3>
        <Navigation lang={lang} currentPath="" variant="footer" />
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-5 opacity-70">
          {lang === "es" ? "Nuestros Servicios" : "Our Services"}
        </h3>
        <ul class="space-y-2 list-none m-0 p-0">
          {activeServices.map((service) => {
            const slug = lang === "es" ? service.slugEs : service.slug;
            const href = lang === "es" ? `/es/servicios/${slug}/` : `/en/services/${slug}/`;
            return (
              <li>
                <a href={href} class="text-white/75 hover:text-accent transition-colors text-sm flex items-center gap-2 group">
                  <svg aria-hidden="true" class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {service.title[lang]}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold text-xs uppercase tracking-widest mb-5 opacity-70">
          {lang === "es" ? "Contacto" : "Contact"}
        </h3>
        <ul class="space-y-4 list-none m-0 p-0">
          <li>
            <a href={`tel:${business.phone}`}
               class="flex items-center gap-3 text-white/75 hover:text-accent transition-colors group">
              <div class="w-8 h-8 rounded-lg bg-white/10 group-hover:bg-accent/20 flex items-center justify-center flex-shrink-0 transition-colors">
                <svg aria-hidden="true" class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-white text-sm font-bold">{business.phoneDisplay}</p>
                <p class="text-white/60 text-xs">{lang === "es" ? "Disponible 24/7" : "Available 24/7"}</p>
              </div>
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`}
               class="flex items-center gap-3 text-white/75 hover:text-accent transition-colors group">
              <div class="w-8 h-8 rounded-lg bg-white/10 group-hover:bg-accent/20 flex items-center justify-center flex-shrink-0 transition-colors">
                <svg aria-hidden="true" class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <p class="text-white/70 text-xs break-all">{business.email}</p>
            </a>
          </li>
        </ul>

        <!-- CTA -->
        <a href={`tel:${business.phone}`}
           class="mt-6 flex items-center justify-center gap-2 w-full bg-accent text-dark font-bold text-sm py-3 rounded-lg hover:bg-accent-light transition-colors">
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {lang === "es" ? "Llamar Ahora" : "Call Now"}
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/50">
      <p>&copy; {currentYear} {business.name}. {lang === "es" ? "Todos los derechos reservados." : "All rights reserved."}</p>
      <a href={privacyPath} class="hover:text-white transition-colors">
        {lang === "es" ? "Política de Privacidad" : "Privacy Policy"}
      </a>
    </div>
  </div>
</footer>

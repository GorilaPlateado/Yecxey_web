---
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;

// Client-approved blocks (2026-10 revision) — no availability or speed promises.
const facts = [
  {
    big: lang === "es" ? "Asistencia móvil" : "Mobile Assistance",
    label: lang === "es" ? "Servicio directo" : "Direct Service",
    desc:
      lang === "es"
        ? "Nos desplazamos hasta donde se encuentre su vehículo para prestarle el servicio solicitado."
        : "We come to wherever your vehicle is located to provide the requested service.",
  },
  {
    big: lang === "es" ? "Atención personalizada" : "Personalized Attention",
    label: lang === "es" ? "Trato directo" : "Clear & Direct Service",
    desc:
      lang === "es"
        ? "Atención directa y comunicación clara para comprender las necesidades de su vehículo."
        : "Direct attention and clear communication to understand your vehicle's needs.",
  },
  {
    big: lang === "es" ? "Dallas-Fort Worth" : "Dallas-Fort Worth",
    label: lang === "es" ? "Área de servicio" : "Service Area",
    desc:
      lang === "es"
        ? "Asistencia móvil para camiones comerciales y otros vehículos."
        : "Mobile assistance for commercial trucks and other vehicles.",
  },
];
---

<section class="section bg-light" aria-labelledby="stats-heading">
  <div class="container">
    <h2 id="stats-heading" class="sr-only">
      {lang === "es" ? "Cómo trabajamos" : "How we work"}
    </h2>
    <dl class="stats-band">
      {facts.map((f) => (
        <div class="stats-item">
          <dt class="stats-big">{f.big}</dt>
          <dd class="stats-label">{f.label}</dd>
          <dd class="stats-desc">{f.desc}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats-band {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1px;
    background: #e2e8f0;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 20px 45px -30px rgba(13, 27, 46, 0.45);
    border: 1px solid #e2e8f0;
  }
  @media (min-width: 640px) {
    .stats-band { grid-template-columns: repeat(3, 1fr); }
  }
  .stats-item {
    margin: 0;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 2rem 1.5rem;
    text-align: center;
    transition: background 0.25s ease;
  }
  .stats-item:hover { background: #fffdf2; }
  .stats-big {
    font-weight: 900;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.15;
    color: #0d1b2e;
    letter-spacing: -0.02em;
  }
  .stats-label {
    margin-top: 0.5rem;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #c8102e;
  }
  .stats-desc {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #556374;
  }
</style>

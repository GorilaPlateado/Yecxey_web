---
import business from "@/data/business";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;

const points = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    title: lang === "es" ? "Área de servicio" : "Service Area",
    desc:
      lang === "es"
        ? "Brindamos asistencia móvil en Dallas, Irving, Addison, Carrollton y Farmers Branch."
        : "We provide mobile assistance in Dallas, Irving, Addison, Carrollton, and Farmers Branch.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V7.618a1 1 0 01.553-.894L9 4m0 16l6-3m-6 3V4m6 0l5.447 2.724A1 1 0 0121 7.382v8.764a1 1 0 01-.553.894L15 17m0-13v13"/>`,
    title: lang === "es" ? "Asistencia en carretera" : "Roadside Assistance",
    desc:
      lang === "es"
        ? "Atendemos camiones comerciales y otros vehículos en carreteras, estacionamientos y patios de carga dentro de nuestra área de servicio."
        : "We serve commercial trucks and other vehicles on highways, parking lots, and loading yards within our service area.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 4h8m-9 8h10a2 2 0 002-2v-1M5 20a2 2 0 01-2-2V7a2 2 0 012-2h11l3 4v9a2 2 0 01-2 2H5zm2-4.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm10 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>`,
    title: lang === "es" ? "Servicio móvil" : "Mobile Service",
    desc:
      lang === "es"
        ? "Nos desplazamos hasta donde se encuentre su vehículo para prestarle el servicio solicitado."
        : "We come to wherever your vehicle is located to provide the requested service.",
  },
];
---

<section class="section bg-white" aria-labelledby="coverage-heading">
  <div class="container">
    <div class="coverage-grid">
      <div class="coverage-copy">
        <span class="section-label">
          {lang === "es" ? "Dónde Estamos" : "Where We Serve"}
        </span>
        <h2 id="coverage-heading" class="text-primary">
          {lang === "es" ? "Asistencia móvil donde usted la necesita" : "Mobile assistance where you need it"}
        </h2>
        <p class="text-muted text-base leading-relaxed mt-4">
          {lang === "es"
            ? "Nuestro servicio móvil ofrece asistencia profesional para camiones comerciales y otros vehículos en el área de Dallas-Fort Worth, Texas, directamente donde se encuentren ubicados."
            : "Our mobile service provides professional assistance for commercial trucks and other vehicles in the Dallas-Fort Worth, Texas area, right where you are located."}
        </p>

        <ul class="coverage-points" role="list">
          {points.map((p) => (
            <li class="coverage-point">
              <span class="coverage-icon">
                <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={p.icon} />
                </svg>
              </span>
              <span>
                <span class="coverage-point-title">{p.title}</span>
                <span class="coverage-point-desc">{p.desc}</span>
              </span>
            </li>
          ))}
        </ul>

        <a href={lang === "es" ? "/es/area-de-servicio/" : "/en/service-area/"} class="coverage-link">
          {lang === "es" ? "Ver área de servicio" : "View service area"}
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="coverage-map">
        <iframe
          title={lang === "es" ? "Mapa de cobertura de GY Roadside Solutions" : "GY Roadside Solutions coverage map"}
          src={business.googleMapsUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .coverage-grid {
    display: grid;
    /* minmax(0, 1fr): el iframe del mapa tiene ancho intrínseco (~425px);
       sin el mínimo en 0, la pista fr no puede encogerse por debajo de él y
       desborda el viewport (scroll horizontal en móvil). */
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .coverage-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.5rem; }
  }
  .coverage-points {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .coverage-point { display: flex; gap: 0.9rem; align-items: flex-start; }
  .coverage-icon {
    flex-shrink: 0;
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem; border-radius: 0.7rem;
    color: #0D1B2E;
    background: linear-gradient(135deg, #F5C518 0%, #FFD740 100%);
    box-shadow: 0 8px 20px -10px rgba(245, 197, 24, 0.75);
  }
  .coverage-point-title { display: block; font-weight: 800; color: #0D1B2E; font-size: 1rem; }
  .coverage-point-desc { display: block; color: #556374; font-size: 0.9rem; line-height: 1.5; margin-top: 0.15rem; }
  .coverage-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: 1.75rem;
    font-weight: 800; color: #C8102E;
  }
  .coverage-link:hover { color: #E8253F; }
  .coverage-map {
    min-width: 0;
    /* aspect-ratio + min-height transfieren 320px×4/3 = 427px de ancho;
       max-width lo mantiene dentro de su columna en móvil. */
    max-width: 100%;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 25px 50px -25px rgba(13, 27, 46, 0.5);
    border: 1px solid #E2E8F0;
    background: #F8FAFC;
    aspect-ratio: 4 / 3;
    min-height: 320px;
  }
  .coverage-map iframe {
    width: 100%; height: 100%; border: 0; display: block;
    filter: grayscale(0.1) contrast(1.02);
  }
</style>

---
import business from "@/data/business";
import { t } from "@/i18n/index";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = t(lang);
const servicesPath = lang === "es" ? `/${lang}/servicios/` : `/${lang}/services/`;
---

<section
  class="relative bg-primary overflow-hidden"
  style="min-height: clamp(520px, 85vh, 800px);"
  aria-labelledby="hero-heading"
>
  <!-- Background photo -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/images/hero/hero-truck.webp"
      alt=""
      class="w-full h-full object-cover object-center brightness-110 saturate-105"
      fetchpriority="high"
      decoding="async"
      onerror="this.style.display='none'"
    />
    <!-- Dark overlay — kept only as a left-side gradient for white-text contrast; right side is bright -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary/90 via-primary/65 to-primary/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-primary/45 via-transparent to-transparent"></div>
  </div>

  <!-- Content -->
  <div class="container relative z-10 flex flex-col justify-center py-16 md:py-24 lg:py-32"
       style="min-height: inherit;">
    <div class="max-w-xl lg:max-w-2xl">

      <!-- Category label — yellow small caps -->
      <span class="section-label" aria-hidden="true">
        {lang === "es" ? "Asistencia en Carretera para Camiones" : "Truck Roadside Assistance"}
      </span>

      <!-- Main headline -->
      <h1 id="hero-heading" class="text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.05] mb-4">
        {lang === "es" ? (
          <>
            Mantén tu Camión<br />
            <span class="text-accent">En Movimiento</span>
          </>
        ) : (
          <>
            Keep Your Truck<br />
            <span class="text-accent">Moving</span>
          </>
        )}
      </h1>

      <!-- Subheadline -->
      <p class="text-white text-lg sm:text-xl font-semibold mb-3">
        {lang === "es"
          ? "Rápido. Confiable. De Regreso a la Carretera."
          : "Fast. Reliable. On the Road Again."}
      </p>

      <!-- Description -->
      <p class="text-white/90 text-base leading-relaxed mb-8 max-w-lg">
        {lang === "es"
          ? `GY Roadside Solutions LLC brinda asistencia en carretera profesional y servicios de reparación para camiones comerciales en todo Estados Unidos.`
          : `GY Roadside Solutions LLC provides professional roadside assistance and repair services for commercial trucks across the United States.`}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 mb-10">
        <a
          href={`tel:${business.phone}`}
          class="btn bg-accent text-dark hover:bg-accent-light shadow-cta text-base sm:text-lg py-4 px-8 font-bold"
          aria-label={`${tr.hero.ctaCall} — ${business.phoneDisplay}`}
        >
          <svg aria-hidden="true" class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {lang === "es" ? "Llamar Ahora" : "Call Now"}
        </a>
        <a
          href={servicesPath}
          class="btn bg-transparent border-2 border-white text-white hover:bg-white hover:text-dark text-base sm:text-lg py-4 px-8 font-semibold"
        >
          {lang === "es" ? "Nuestros Servicios" : "Our Services"}
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Trust badges row -->
      <div class="flex flex-wrap gap-6 sm:gap-10" role="list" aria-label={lang === "es" ? "Garantías" : "Trust signals"}>
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
            label: lang === "es" ? "Respuesta Rápida" : "Fast Response",
            sub: lang === "es" ? "De regreso a la ruta" : "Get back on the road",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
            label: lang === "es" ? "Servicio Profesional" : "Professional Service",
            sub: lang === "es" ? "Técnicos con experiencia" : "Experienced technicians",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>`,
            label: lang === "es" ? "Para Camiones Comerciales" : "For Commercial Trucks",
            sub: lang === "es" ? "Hecho para su negocio" : "Built for your business",
          },
        ].map((item) => (
          <div class="flex items-center gap-3" role="listitem">
            <div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
              <svg aria-hidden="true" class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <div>
              <p class="text-white text-sm font-bold leading-none mb-0.5">{item.label}</p>
              <p class="text-white/60 text-xs">{item.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

---
import business from "@/data/business";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="emergency-band" aria-labelledby="emergency-heading">
  <div class="container relative z-10">
    <div class="emergency-inner">
      <div class="emergency-text">
        <span class="emergency-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          {lang === "es" ? "Emergencia 24/7" : "24/7 Emergency"}
        </span>
        <h2 id="emergency-heading" class="emergency-title">
          {lang === "es"
            ? "¿Varado en la carretera ahora mismo?"
            : "Stranded on the road right now?"}
        </h2>
        <p class="emergency-sub">
          {lang === "es"
            ? "No espere. Un técnico de camiones comerciales está listo para atenderle en este momento."
            : "Don't wait. A commercial truck technician is standing by to help you right now."}
        </p>
      </div>

      <div class="emergency-action">
        <a href={`tel:${business.phone}`} class="emergency-call">
          <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="emergency-call-label">
            {lang === "es" ? "Llamar Ahora" : "Call Now"}
            <span class="emergency-phone">{business.phoneDisplay}</span>
          </span>
        </a>
        <a href={lang === "es" ? "/es/contacto/" : "/en/contact-us/"} class="emergency-secondary">
          {lang === "es" ? "Solicitar asistencia" : "Request assistance"}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .emergency-band {
    position: relative;
    padding: 4rem 0;
    background: radial-gradient(120% 160% at 15% 0%, #1A2F4A 0%, #0D1B2E 55%, #081120 100%);
    overflow: hidden;
  }
  .emergency-band::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 60% at 85% 20%, rgba(200, 16, 46, 0.28), transparent 70%),
      radial-gradient(45% 70% at 95% 90%, rgba(245, 197, 24, 0.18), transparent 70%);
    pointer-events: none;
  }
  .emergency-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 900px) {
    .emergency-band { padding: 5rem 0; }
    .emergency-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: 3rem;
    }
    .emergency-text { max-width: 34rem; }
  }
  .emergency-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgba(200, 16, 46, 0.15);
    border: 1px solid rgba(232, 37, 63, 0.5);
    color: #ff8a99;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .pulse-dot {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: #e8253f;
    box-shadow: 0 0 0 0 rgba(232, 37, 63, 0.7);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(232, 37, 63, 0.6); }
    70%  { box-shadow: 0 0 0 10px rgba(232, 37, 63, 0); }
    100% { box-shadow: 0 0 0 0 rgba(232, 37, 63, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-dot { animation: none; }
  }
  .emergency-title {
    margin-top: 1rem;
    color: #ffffff;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 900;
    line-height: 1.15;
  }
  .emergency-sub {
    margin-top: 0.85rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .emergency-action {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
    flex-shrink: 0;
  }
  @media (min-width: 480px) {
    .emergency-action { flex-direction: row; align-items: center; }
  }
  .emergency-call {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.75rem;
    border-radius: 0.9rem;
    background: linear-gradient(135deg, #F5C518 0%, #FFD740 100%);
    color: #0D1B2E;
    font-weight: 900;
    box-shadow: 0 14px 30px -12px rgba(245, 197, 24, 0.7);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
    min-height: 48px;
  }
  .emergency-call:hover { transform: translateY(-2px); box-shadow: 0 18px 36px -12px rgba(245, 197, 24, 0.85); }
  .emergency-call:active { transform: scale(0.97); }
  .emergency-call-label { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.1; font-size: 0.85rem; }
  .emergency-phone { font-size: 1.25rem; font-weight: 900; }
  .emergency-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.5rem;
    border-radius: 0.9rem;
    border: 2px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-weight: 700;
    min-height: 48px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .emergency-secondary:hover { background: #ffffff; color: #0D1B2E; }
</style>

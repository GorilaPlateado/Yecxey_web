---
import type { Review } from "@/data/reviews";
import type { Lang } from "@/i18n/index";

export interface Props {
  review: Review;
  lang: Lang;
}

const { review, lang } = Astro.props;
const tr_source = {
  Google: lang === "es" ? "Reseña de Google" : "Google Review",
  Facebook: lang === "es" ? "Reseña de Facebook" : "Facebook Review",
  Yelp: lang === "es" ? "Reseña de Yelp" : "Yelp Review",
  Direct: lang === "es" ? "Reseña directa" : "Direct Review",
};
---

<article
  class="card p-6 flex flex-col gap-4 h-full"
  aria-label={`${lang === "es" ? "Reseña de" : "Review by"} ${review.name}`}
  itemscope
  itemtype="https://schema.org/Review"
>
  <!-- Stars -->
  <div class="flex items-center gap-1" aria-label={`${review.rating} ${lang === "es" ? "estrellas de 5" : "stars out of 5"}`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        aria-hidden="true"
        class={`w-5 h-5 ${i < review.rating ? "text-yellow-400" : "text-gray-200"}`}
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    ))}
  </div>

  <!-- Review text -->
  <blockquote class="flex-1 text-dark text-sm leading-relaxed italic" itemprop="reviewBody">
    "{review.text[lang]}"
  </blockquote>

  <!-- Author + meta -->
  <footer class="flex items-center justify-between gap-2 pt-3 border-t border-border">
    <div itemprop="author" itemscope itemtype="https://schema.org/Person">
      <p class="font-semibold text-dark text-sm" itemprop="name">{review.name}</p>
      <p class="text-muted text-xs">{review.location}</p>
    </div>
    <div class="flex flex-col items-end gap-1">
      <span class="badge-primary text-xs">{tr_source[review.source]}</span>
      <time class="text-muted text-xs" datetime={review.date}>{review.date}</time>
    </div>
  </footer>
</article>

---
import type { Review } from "@/data/reviews";
import type { Lang } from "@/i18n/index";

export interface Props {
  review: Review;
  lang: Lang;
}

const { review, lang } = Astro.props;
const tr_source = {
  Google: lang === "es" ? "Reseña de Google" : "Google Review",
  Facebook: lang === "es" ? "Reseña de Facebook" : "Facebook Review",
  Yelp: lang === "es" ? "Reseña de Yelp" : "Yelp Review",
  Direct: lang === "es" ? "Reseña directa" : "Direct Review",
};

// Up to two initials for the avatar
const initials = review.name
  .split(" ")
  .filter(Boolean)
  .map((w) => w[0])
  .slice(0, 2)
  .join("")
  .toUpperCase();

// Human-readable localized date (e.g. "Sep 18, 2026" / "18 sep 2026")
const dateFormatted = new Intl.DateTimeFormat(lang === "es" ? "es-MX" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(new Date(`${review.date}T00:00:00`));
---

<article
  class="card group relative flex h-full flex-col p-6 md:p-7 transition-transform duration-300 hover:-translate-y-1"
  aria-label={`${lang === "es" ? "Reseña de" : "Review by"} ${review.name}`}
  itemscope
  itemtype="https://schema.org/Review"
>
  <!-- Top accent bar -->
  <span class="absolute inset-x-0 top-0 h-1 bg-accent" aria-hidden="true"></span>

  <!-- Decorative quote glyph -->
  <span
    class="pointer-events-none absolute right-5 top-3 select-none font-serif text-7xl leading-none text-primary/10"
    aria-hidden="true"
  >&rdquo;</span>

  <!-- Stars -->
  <div class="flex items-center gap-1" aria-label={`${review.rating} ${lang === "es" ? "estrellas de 5" : "stars out of 5"}`}>
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        aria-hidden="true"
        class={`w-5 h-5 ${i < review.rating ? "text-accent" : "text-gray-200"}`}
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    ))}
  </div>

  <!-- Review text -->
  <blockquote class="relative mt-4 flex-1 text-dark leading-relaxed" itemprop="reviewBody">
    &ldquo;{review.text[lang]}&rdquo;
  </blockquote>

  <!-- Author + meta -->
  <footer class="mt-6 flex items-center justify-between gap-3 border-t border-border pt-5">
    <div class="flex items-center gap-3" itemprop="author" itemscope itemtype="https://schema.org/Person">
      <span
        class="grid h-11 w-11 flex-shrink-0 place-items-center rounded-full bg-primary text-sm font-bold text-white"
        aria-hidden="true"
      >{initials}</span>
      <div>
        <p class="text-sm font-semibold leading-tight text-dark" itemprop="name">{review.name}</p>
        <p class="text-xs text-muted">{review.location}</p>
      </div>
    </div>
    <div class="flex flex-col items-end gap-1">
      <span class="badge-primary text-xs">{tr_source[review.source]}</span>
      <time class="text-xs text-muted" datetime={review.date}>{dateFormatted}</time>
    </div>
  </footer>
</article>

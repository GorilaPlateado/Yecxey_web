---
import business from "@/data/business";
import type { Lang } from "@/i18n/index";

export interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="bg-primary py-16 md:py-20" aria-labelledby="trust-heading">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left: heading + description -->
      <div>
        <span class="section-label">
          {lang === "es" ? "¿Por Qué Elegirnos?" : "Why Choose Us"}
        </span>
        <h2 id="trust-heading" class="text-white text-3xl md:text-4xl font-black leading-tight mb-4">
          {lang === "es"
            ? "Comprometidos con su tranquilidad\nen la carretera"
            : "Committed to your peace of mind\non the road"}
        </h2>
        <p class="text-white/85 text-base leading-relaxed mb-8 max-w-md">
          {lang === "es"
            ? "Sabemos lo importante que es mantener su vehículo en funcionamiento. Por eso, ofrecemos asistencia móvil con seriedad, responsabilidad y compromiso, directamente donde se encuentre su vehículo."
            : "We know how important it is to keep your vehicle running. That is why we provide mobile assistance with seriousness, responsibility, and commitment, right where your vehicle is located."}
        </p>
        <a
          href={`tel:${business.phone}`}
          class="btn bg-accent text-dark hover:bg-accent-light shadow-cta font-bold"
        >
          <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {business.phoneDisplay}
        </a>
      </div>

      <!-- Right: 4 trust items grid — visible borders delimit each block -->
      <div class="grid grid-cols-2 gap-4">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>`,
            title: lang === "es" ? "Atención al cliente" : "Customer Service",
            desc:  lang === "es" ? "Sus necesidades y su tiempo son importantes para nosotros." : "Your needs and your time are important to us.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
            title: lang === "es" ? "Servicio confiable" : "Reliable Service",
            desc:  lang === "es" ? "Trabajamos con seriedad, responsabilidad y compromiso." : "We work with seriousness, responsibility, and commitment.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 4h8m-9 8h10a2 2 0 002-2v-1M5 20a2 2 0 01-2-2V7a2 2 0 012-2h11l3 4v9a2 2 0 01-2 2H5zm2-4.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm10 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>`,
            title: lang === "es" ? "Asistencia móvil" : "Mobile Assistance",
            desc:  lang === "es" ? "Nos desplazamos hasta donde se encuentre su vehículo." : "We come to wherever your vehicle is located.",
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
            title: lang === "es" ? "Menos tiempo inactivo" : "Less Downtime",
            desc:  lang === "es" ? "Trabajamos para ayudarle a retomar su actividad lo antes posible." : "We work to help you get back to business as soon as possible.",
          },
        ].map((item) => (
          <div class="bg-white/5 rounded-xl p-5 border-2 border-white/30 hover:border-accent/60 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center mb-3">
              <svg aria-hidden="true" class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <h3 class="text-white font-bold text-sm mb-1">{item.title}</h3>
            <p class="text-white/70 text-xs leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
